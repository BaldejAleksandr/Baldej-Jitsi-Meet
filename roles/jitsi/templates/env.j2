# {{ ansible_managed }}
CONFIG={{ jitsi_config_dir }}
HTTP_PORT={{ jitsi_http_port }}
HTTPS_PORT={{ jitsi_https_port }}
TZ={{ jitsi_tz }}
PUBLIC_URL={{ jitsi_public_url }}
JVB_ADVERTISE_IPS={{ jitsi_advertise_ips }}
JITSI_IMAGE_VERSION={{ jitsi_version }}
RESTART_POLICY=unless-stopped

# TLS терминирует Nginx Proxy Manager
ENABLE_LETSENCRYPT=0
ENABLE_HTTP_REDIRECT=0
ENABLE_XMPP_WEBSOCKET=1

ENABLE_AUTH={{ jitsi_enable_auth | ternary(1, 0) }}
ENABLE_RECORDING={{ jitsi_enable_recording | ternary(1, 0) }}

JICOFO_AUTH_PASSWORD={{ jitsi_jicofo_auth_password }}
JVB_AUTH_PASSWORD={{ jitsi_jvb_auth_password }}
JIGASI_XMPP_PASSWORD={{ jitsi_jigasi_xmpp_password }}
JIGASI_TRANSCRIBER_PASSWORD={{ jitsi_jigasi_transcriber_password }}
JIBRI_RECORDER_PASSWORD={{ jitsi_jibri_recorder_password }}
JIBRI_XMPP_PASSWORD={{ jitsi_jibri_xmpp_password }}
{% if jitsi_file_sharing_enabled | default(false) | bool %}

# Обмен файлами в чате (роль jitsi_file_sharing)
# external_services выдаёт клиенту короткоживущий токен; в образе он включён
# только при TURN_HOST, поэтому подключаем его явно
XMPP_MODULES=short_lived_token,external_services
{% if jitsi_file_sharing_upload_for_all | default(false) | bool %}
XMPP_MUC_MODULES=file_sharing_everyone
{% endif %}
{% endif %}
{% for key, value in jitsi_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
