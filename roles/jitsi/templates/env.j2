# {{ ansible_managed }}
CONFIG={{ jitsi_config_dir }}
HTTP_PORT={{ jitsi_http_port }}
HTTPS_PORT={{ jitsi_https_port }}
TZ={{ jitsi_tz }}
PUBLIC_URL={{ jitsi_public_url }}
JVB_ADVERTISE_IPS={{ jitsi_advertise_ips }}
JITSI_IMAGE_VERSION={{ jitsi_version }}
RESTART_POLICY=unless-stopped

# TLS is terminated by a reverse proxy, e.g. Nginx Proxy Manager - TLS терминирует обратный прокси, например Nginx Proxy Manager
ENABLE_LETSENCRYPT=0
ENABLE_HTTP_REDIRECT=0
ENABLE_XMPP_WEBSOCKET=1

ENABLE_AUTH={{ jitsi_enable_auth | ternary(1, 0) }}
ENABLE_RECORDING={{ jitsi_enable_recording | ternary(1, 0) }}

JICOFO_AUTH_PASSWORD={{ jitsi_jicofo_auth_password }}
JVB_AUTH_PASSWORD={{ jitsi_jvb_auth_password }}
JIGASI_XMPP_PASSWORD={{ jitsi_jigasi_xmpp_password }}
JIGASI_TRANSCRIBER_PASSWORD={{ jitsi_jigasi_transcriber_password }}
JIBRI_RECORDER_PASSWORD={{ jitsi_jibri_recorder_password }}
JIBRI_XMPP_PASSWORD={{ jitsi_jibri_xmpp_password }}
{% set jitsi_file_sharing_on = jitsi_file_sharing_enabled | default(false) | bool %}
{% set jitsi_monitoring_on = monitoring_enabled | default(false) | bool %}
{% set jitsi_xmpp_modules = (['short_lived_token', 'external_services'] if jitsi_file_sharing_on else [])
                            + (['muc_census'] if jitsi_monitoring_on else []) %}
{% if jitsi_xmpp_modules %}

# Extra Prosody modules, set by roles jitsi_file_sharing and monitoring - Дополнительные модули Prosody, их задают роли jitsi_file_sharing и monitoring
# short_lived_token, external_services: file sharing token; the image enables external_services only with TURN_HOST - short_lived_token, external_services: токен для обмена файлами; в образе external_services включён только при TURN_HOST
# muc_census: list of rooms at http://prosody:5280/room-census, inside the docker network only - muc_census: список комнат на http://prosody:5280/room-census, только внутри docker-сети
XMPP_MODULES={{ jitsi_xmpp_modules | join(',') }}
{% endif %}
{% if jitsi_file_sharing_on and (jitsi_file_sharing_upload_for_all | default(false) | bool) %}
XMPP_MUC_MODULES=file_sharing_everyone
{% endif %}
{% if jitsi_monitoring_on %}

# Monitoring, role monitoring: Jicofo metrics at http://jicofo:8888/metrics - Мониторинг, роль monitoring: метрики Jicofo на http://jicofo:8888/metrics
JICOFO_ENABLE_REST=1
{% endif %}
{% for key, value in jitsi_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
