#!/bin/bash
# {{ ansible_managed }}
# Jibri recordings cleanup, run by cron (role jitsi) - Автоочистка записей Jibri, запускается cron (роль jitsi)
# Deletes recordings past retention - Удаляет записи старше срока хранения
# and the oldest ones while the total is over the limit - и самые старые, пока общий объём больше лимита
#
# A recording is a top-level entry in $DIR - Запись: элемент верхнего уровня в $DIR
# (a Jibri session dir with mp4 + metadata.json, or a file) - (каталог сессии Jibri с mp4 + metadata.json или файл)
# Its age is the age of its newest file - Возраст записи считается по самому свежему файлу внутри
# Entries changed in the last $ACTIVE_MINUTES minutes are skipped, Jibri is still writing - Записи, менявшиеся последние $ACTIVE_MINUTES минут, пропускаются: Jibri ещё пишет их
set -euo pipefail

DIR={{ jitsi_recordings_dir | quote }}
RETENTION_MINUTES=$(( {{ jitsi_recordings_retention_days | int }} * 24 * 60 ))
MAX_BYTES={{ ((jitsi_recordings_max_total_size_gb | float) * 1024 * 1024 * 1024) | int }}
ACTIVE_MINUTES=10

[ -d "$DIR" ] || exit 0

log() { logger -t jitsi-recordings-cleanup -- "$*" 2>/dev/null || echo "$*"; }

now=$(date +%s)
entries=()
count=0
total=0
while IFS= read -r -d '' entry; do
    newest=$(find "$entry" -type f -printf '%T@\n' | sort -n | tail -n 1)
    [ -n "$newest" ] || newest=$(stat -c %Y -- "$entry")
    newest=${newest%.*}
    size=$(du -sb -- "$entry" | cut -f 1)
    total=$(( total + size ))
    count=$(( count + 1 ))
    entries+=("$newest $size $entry")
done < <(find "$DIR" -mindepth 1 -maxdepth 1 -print0)

(( count )) || exit 0

# oldest first - от самых старых к самым новым
mapfile -t sorted < <(printf '%s\n' "${entries[@]}" | sort -n)

for item in "${sorted[@]}"; do
    read -r newest size path <<< "$item"
    [ -n "$path" ] || continue

    age=$(( (now - newest) / 60 ))
    (( age >= ACTIVE_MINUTES )) || continue

    if (( age > RETENTION_MINUTES )); then
        reason="старше срока хранения"
    elif (( total > MAX_BYTES )); then
        reason="превышен общий лимит"
    else
        continue
    fi

    rm -rf -- "$path"
    total=$(( total - size ))
    log "удалена запись $path ($reason, $size байт)"
done
