# {{ ansible_managed }}
# Included into server{} of the web container via nginx-custom/*.conf - Подключается в server{} контейнера web через nginx-custom/*.conf
location ^~ /file-service/ {
    # Resolved per request, so web starts even if the service is down - Имя резолвится при запросе: web стартует, даже если сервис не поднят
    set $file_sharing_upstream http://file-sharing.meet.jitsi:3000;
    rewrite ^/file-service(/.*)$ $1 break;
    proxy_pass $file_sharing_upstream;

    client_max_body_size {{ (jitsi_file_sharing_max_file_size_mb | int) + 1 }}m;
    # Stream the upload to the service instead of buffering it first - Передавать загрузку сервису сразу, а не после полной буферизации
    # Otherwise the token is checked only after the whole file arrives and may expire - Иначе токен проверяется только после приёма всего файла и успевает истечь
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}
