-- {{ ansible_managed }}
-- File sharing in chat, loaded by Prosody via Include "conf.d/*.cfg.lua" - Обмен файлами в чате, Prosody подключает файл через Include "conf.d/*.cfg.lua"
-- Modules short_lived_token, external_services, file_sharing_everyone - Модули short_lived_token, external_services, file_sharing_everyone
-- are enabled via XMPP_MODULES and XMPP_MUC_MODULES in .env (role jitsi) - включаются через XMPP_MODULES и XMPP_MUC_MODULES в .env (роль jitsi)

-- Short-lived tokens the client uses with the file service - Короткоживущие токены, которыми клиент авторизуется в сервисе файлов
short_lived_token = {
    issuer = "prosody";
    accepted_audiences = { "file-sharing" };
    key_path = "/run/prosody/config/file-sharing/short_lived_token.key";
    key_id = "jitsi/short_lived_token";
    ttl_seconds = {{ jitsi_file_sharing_token_ttl_seconds | int }};
};

-- Moderator permissions without JWT: mod_jitsi_permissions defaults + file-upload - Права модератора без JWT: значения mod_jitsi_permissions по умолчанию + file-upload
jitsi_default_permissions = {
    livestreaming = true;
    recording = true;
    transcription = true;
    ["outbound-call"] = true;
    ["create-polls"] = true;
    ["send-groupchat"] = true;
    flip = true;
    ["live-translation"] = true;
    ["live-translation-subscribe"] = true;
    ["file-upload"] = true;
};

-- Keeps the room's file list and sends it to participants - Хранит список файлов комнаты и рассылает его участникам
Component "filesharing.{{ jitsi_file_sharing_xmpp_domain }}" "filesharing_component"
    muc_component = "{{ jitsi_file_sharing_xmpp_muc_domain }}"
