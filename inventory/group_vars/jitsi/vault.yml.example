---
# Passwords of internal Jitsi services, not in git - Пароли внутренних сервисов Jitsi, не в git
# Create an encrypted vault.yml with random passwords - Создать зашифрованный vault.yml со случайными паролями:
#
#   openssl rand -base64 32 > .vault_pass && chmod 600 .vault_pass
#   for k in jicofo_auth jvb_auth jigasi_xmpp jigasi_transcriber jibri_recorder jibri_xmpp; do
#     echo "vault_jitsi_${k}_password: $(openssl rand -hex 16)"
#   done > inventory/group_vars/jitsi/vault.yml
#   echo "vault_monitoring_grafana_admin_password: $(openssl rand -hex 16)" >> inventory/group_vars/jitsi/vault.yml
#   ansible-vault encrypt inventory/group_vars/jitsi/vault.yml
#
# Required variables - Нужные переменные:
vault_jitsi_jicofo_auth_password: CHANGE_ME
vault_jitsi_jvb_auth_password: CHANGE_ME
vault_jitsi_jigasi_xmpp_password: CHANGE_ME
vault_jitsi_jigasi_transcriber_password: CHANGE_ME
vault_jitsi_jibri_recorder_password: CHANGE_ME
vault_jitsi_jibri_xmpp_password: CHANGE_ME
vault_monitoring_grafana_admin_password: CHANGE_ME_GRAFANA
